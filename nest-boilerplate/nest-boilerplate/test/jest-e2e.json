{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "roots": ["<rootDir>/test"],
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.ts$": [
      "ts-jest",
      {
        "tsconfig": "<rootDir>/tsconfig.test.json",
        "diagnostics": true
      }
    ]
  },
  "testEnvironment": "node",
  "globalSetup": "<rootDir>/test/global-setup.ts",
  "setupFiles": ["<rootDir>/test/setup-e2e-env.ts"],
  "moduleNameMapper": {
    "^@/src/(.*)$": "<rootDir>/src/$1",
    "^@/(.*)$": "<rootDir>/src/$1"
  }
}
