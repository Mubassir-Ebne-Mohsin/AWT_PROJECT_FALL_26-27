# StressForge API — copy to .env and adjust. Never commit .env.

NODE_ENV=development            # development | test | production
PORT=5001
CORS_ORIGINS=http://localhost:3000   # comma-separated list of allowed browser origins
FRONTEND_URL=http://localhost:3000
TRUST_PROXY_HOPS=0              # number of reverse proxies in front of the API

# PostgreSQL: host port 5433 avoids local Postgres conflicts; container stays on 5432.
# Choose another free DB_PORT before Compose if 5433 is occupied.
DB_HOST=localhost
DB_PORT=5433
DB_USER=stressforge
DB_PASSWORD=stressforge
DB_DATABASE=stressforge

# Redis (matches docker-compose.dev.yml)
REDIS_HOST=localhost
REDIS_PORT=6379
# Optional: shared by Compose Redis, healthcheck and API clients.
# Quote # or spaces; single-quote values containing a literal $ in Compose .env.
REDIS_PASSWORD=

# JWT — generate TWO independent secrets, each at least 32 characters.
# Production rejects these published placeholders and equal signing secrets.
# Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900          # 15 minutes
JWT_REFRESH_TTL_SECONDS=604800      # 7 days

# Rate limits, requests per minute per client IP
THROTTLE_LIMIT=120
AUTH_THROTTLE_LIMIT=10              # login / register / refresh

# Demo user created by `pnpm seeder:run:dev`: demo@stressforge.dev
DEMO_USER_PASSWORD=Demo-Pass-123!

# Experimental M11 backend only. Keep false: M10's model quality/resource gate failed.
AI_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
# No browser calls Ollama directly. Only these loopback origins/model names are accepted.
AI_DEADLINE_MS=60000
# Host physical and commit/virtual headroom checked before inference. Never lower these floors.
AI_MIN_FREE_MIB=1536
AI_MIN_COMMIT_MIB=4096
# Which provider explains results: ollama (local) or groq (hosted, free plan). Choosing groq sends the bounded facts of ONE run
# to Groq on an explicit Explain click. Put the key here yourself; never commit it, never expose it to the browser.
AI_PROVIDER=ollama
GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=
# The free limits your Groq console shows for the model, and the share of them this app may use (never the whole).
GROQ_LIMIT_RPM=30
GROQ_LIMIT_RPD=1000
GROQ_LIMIT_TPM=8000
GROQ_LIMIT_TPD=200000
GROQ_QUOTA_MARGIN=0.8
AI_USER_DAILY_LIMIT=50
