# StressForge API — copy to .env and adjust. Never commit .env.

NODE_ENV=development            # development | test | production
PORT=5001
CORS_ORIGINS=http://localhost:3000   # comma-separated list of allowed browser origins
FRONTEND_URL=http://localhost:3000
TRUST_PROXY_HOPS=0              # number of reverse proxies in front of the API

# PostgreSQL: host port 5433 avoids local Postgres conflicts; container stays on 5432.
# Choose another free DB_PORT before Compose if 5433 is occupied.
DB_HOST=localhost
DB_PORT=5433
DB_USER=stressforge
DB_PASSWORD=stressforge
DB_DATABASE=stressforge

# Redis (matches docker-compose.dev.yml)
REDIS_HOST=localhost
REDIS_PORT=6379
# Optional: shared by Compose Redis, healthcheck and API clients.
# Quote # or spaces; single-quote values containing a literal $ in Compose .env.
REDIS_PASSWORD=

# JWT — generate TWO independent secrets, each at least 32 characters.
# Production rejects these published placeholders and equal signing secrets.
# Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900          # 15 minutes
JWT_REFRESH_TTL_SECONDS=604800      # 7 days

# Rate limits, requests per minute per client IP
THROTTLE_LIMIT=120
AUTH_THROTTLE_LIMIT=10              # login / register / refresh

# Demo user created by `pnpm seeder:run:dev`: demo@stressforge.dev
DEMO_USER_PASSWORD=Demo-Pass-123!
