{
  "name": "stressforge-api",
  "private": true,
  "version": "1.0.0",
  "description": "StressForge API: architecture stress-testing platform (NestJS)",
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/jest/bin/jest.js --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "migration:create": "typeorm-ts-node-commonjs migration:create",
    "migration:run": "ts-node -r tsconfig-paths/register ./src/script/typeorm_migration_run.ts",
    "migration:rollback": "ts-node -r tsconfig-paths/register ./src/script/typeorm_migration_rollback.ts",
    "migration:rollbackAll": "ts-node -r tsconfig-paths/register ./src/script/typeorm_migration_rollback_all.ts",
    "entity:create": "typeorm-ts-node-commonjs entity:create",
    "seeder:run": "node dist/seeder",
    "seeder:refresh": "node dist/seeder --refresh",
    "seeder:run:dev": "ts-node -r tsconfig-paths/register src/seeder",
    "seeder:refresh:dev": "ts-node -r tsconfig-paths/register src/seeder --refresh",
    "lint:check": "eslint \"{src,test}/**/*.ts\"",
    "db:up": "docker compose -f docker-compose.dev.yml up -d --wait",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "typecheck": "tsc --project tsconfig.test.json --noEmit",
    "contract:phase2": "ts-node -r tsconfig-paths/register src/script/export-phase2-contract.ts",
    "contract:phase2:check": "pnpm contract:phase2 --check",
    "fixtures:phase2": "node ../../docs/contracts/capture-reference.cjs --check",
    "test:simulation": "jest --runInBand --runTestsByPath src/modules/simulation/engine/engine.spec.ts src/modules/simulation/worker/worker.spec.ts",
    "simulation:profile": "ts-node -r tsconfig-paths/register src/script/profile-simulation.ts",
    "simulation:profile:compiled": "node dist/script/profile-simulation.js",
    "simulation:health:verify": "ts-node -r tsconfig-paths/register src/script/verify-simulation-health.ts"
  },
  "dependencies": {
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/bull": "^11.0.5",
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^11.0.3",
    "argon2": "^0.44.0",
    "bull": "^4.16.5",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "nestjs-seeder": "^0.3.2",
    "nestjs-zod": "^5.5.0",
    "pg": "^8.23.1",
    "redis": "^5.12.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.31",
    "zod": "^4.6.7",
    "zod-validation-error": "^5.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.7",
    "@swc/cli": "^0.7.10",
    "@swc/core": "^1.16.20",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-no-relative-import-paths": "^1.7.3",
    "eslint-plugin-prettier": "^5.5.7",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "@types/pg": "^8.15.6"
  },
  "pnpm": {
    "overrides": {
      "form-data": ">=4.0.0",
      "tough-cookie": ">=4.1.3",
      "cookie": ">=0.7.0",
      "tmp": ">=0.2.4",
      "@nestjs/swagger>js-yaml": "5.5.0",
      "@nestjs/platform-express>multer": "2.5.0",
      "bull>uuid": "11.1.1",
      "nestjs-seeder>@faker-js/faker": "10.5.0"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*.spec.ts$",
    "transform": {
      "^.+.ts$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/../tsconfig.test.json",
          "diagnostics": true
        }
      ]
    },
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/../test/setup-env.ts"
    ],
    "moduleNameMapper": {
      "^@/src/(.*)$": "<rootDir>/$1",
      "^@/(.*)$": "<rootDir>/$1"
    }
  },
  "packageManager": "pnpm@10.34.7"
}
