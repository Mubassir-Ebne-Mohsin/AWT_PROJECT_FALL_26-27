{
  "name": "stressforge-api",
  "private": true,
  "version": "1.0.0",
  "description": "StressForge API: architecture stress-testing platform (NestJS)",
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/jest/bin/jest.js --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "migration:create": "typeorm-ts-node-commonjs migration:create",
    "migration:run": "ts-node -r tsconfig-paths/register ./src/script/typeorm_migration_run.ts",
    "migration:rollback": "ts-node -r tsconfig-paths/register ./src/script/typeorm_migration_rollback.ts",
    "migration:rollbackAll": "ts-node -r tsconfig-paths/register ./src/script/typeorm_migration_rollback_all.ts",
    "entity:create": "typeorm-ts-node-commonjs entity:create",
    "seeder:run": "node dist/seeder",
    "seeder:refresh": "node dist/seeder --refresh",
    "seeder:run:dev": "ts-node -r tsconfig-paths/register src/seeder",
    "seeder:refresh:dev": "ts-node -r tsconfig-paths/register src/seeder --refresh",
    "lint:check": "eslint \"{src,test}/**/*.ts\"",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:down": "docker compose -f docker-compose.dev.yml down"
  },
  "dependencies": {
    "@nest-lab/throttler-storage-redis": "^1.1.0",
    "@nestjs/bull": "^11.0.4",
    "@nestjs/common": "^11.1.8",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.8",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/platform-express": "^11.1.8",
    "@nestjs/platform-socket.io": "^11.1.9",
    "@nestjs/swagger": "^11.2.1",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.0",
    "@nestjs/websockets": "^11.1.9",
    "argon2": "^0.44.0",
    "bull": "^4.16.5",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.2",
    "nestjs-seeder": "^0.3.2",
    "nestjs-zod": "^5.0.1",
    "pg": "^8.16.3",
    "redis": "^5.9.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1",
    "typeorm": "^0.3.27",
    "zod": "^4.1.12",
    "zod-validation-error": "^5.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.8",
    "@swc/cli": "^0.7.8",
    "@swc/core": "^1.14.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.0",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-no-relative-import-paths": "^1.6.1",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^30.2.0",
    "prettier": "^3.6.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "form-data": ">=4.0.0",
      "tough-cookie": ">=4.1.3",
      "cookie": ">=0.7.0",
      "tmp": ">=0.2.4"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*.spec.ts$",
    "transform": {
      "^.+.ts$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/../tsconfig.json",
          "diagnostics": false,
          "isolatedModules": true
        }
      ]
    },
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/../test/setup-env.ts"
    ],
    "moduleNameMapper": {
      "^@/src/(.*)$": "<rootDir>/$1",
      "^@/(.*)$": "<rootDir>/$1"
    }
  }
}
